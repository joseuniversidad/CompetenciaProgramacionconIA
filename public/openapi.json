  "paths": {
    "/departments": {
      "get": {
        "summary": "Catálogo de departamentos",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Datos consultados correctamente. Unidades: kW, kWh, kg CO2 y toneladas."
          },
          "404": {
            "description": "Registro no encontrado"
          },
          "422": {
            "description": "Parámetros inválidos; JSON message y errors"
          },
          "429": {
            "description": "Límite de solicitudes excedido"
          }
        }
      }
    },
